# OpenAI API Configuration
# For standard OpenAI:
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# For OpenRouter (https://openrouter.ai):
# OPENAI_API_KEY=sk-or-your-openrouter-key-here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini

# For other OpenAI-compatible APIs (e.g., Together, Groq, local LLMs):
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=https://api.together.xyz/v1
# OPENAI_MODEL=meta-llama/Llama-3-70b-chat-hf

# Google Sheets Configuration
GOOGLE_SHEETS_ID=your-google-sheet-id-here
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Server Configuration
PORT=8000
FRONTEND_URL=http://localhost:5173
